# Push-уведомления о сработавших алертах через Telegram-бота.
# Скопируйте этот файл в .env (в корень проекта) и заполните значения.
# Файл .env уже в .gitignore — токены не попадут в репозиторий.

# Токен бота, полученный у @BotFather (формат: 123456789:AA...)
TELEGRAM_BOT_TOKEN=

# Chat_id получателя: ваш id в личке с ботом или id группы (-100...).
# Как узнать: напишите боту сообщение и откройте
# https://api.telegram.org/bot<TOKEN>/getUpdates -> result[0].message.chat.id
# (или посмотрите masked-статус/подсказку в GET /api/notifications/status).
TELEGRAM_CHAT_ID=
